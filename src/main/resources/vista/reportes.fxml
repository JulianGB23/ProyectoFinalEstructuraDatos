<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="controladores.ReportesController">
    <VBox spacing="15">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Reportes del Sistema" />

        <HBox spacing="10">
            <Button onAction="#reporteParticipacion" style="-fx-background-color: #5e77ff;" text="Estudiantes más participativos" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#reporteMasValorados" style="-fx-background-color: #5e77ff;" text="Contenidos más valorados" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#reporteMasConectados" style="-fx-background-color: #5e77ff;" text="Conexiones destacadas" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#reporteComunidades" style="-fx-background-color: #5e77ff;" text="Comunidades (clústeres)" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
        </HBox>

        <TextArea fx:id="resultadoArea" editable="false" prefHeight="400" wrapText="true" />

        <Button onAction="#exportarPDF" style="-fx-background-color: #5e77ff;" text="Exportar a PDF" textFill="WHITE">
         <font>
            <Font name="Book Antiqua" size="12.0" />
         </font></Button>
    </VBox>
</AnchorPane>
