<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controladores.PublicarContenidoController"
      spacing="10" style="-fx-padding: 15;" prefWidth="400" prefHeight="350">

    <Label text="Publicar Nuevo Contenido" style="-fx-font-size: 16px;"/>

    <TextField fx:id="campoTitulo" promptText="Título del contenido"/>

    <ComboBox fx:id="comboTipo" promptText="Tipo de contenido"/>

    <TextArea fx:id="campoDescripcion" promptText="Descripción (opcional)" prefRowCount="3"/>


    <HBox spacing="10">
        <Button text="Publicar" onAction="#publicar"/>
        <Button text="Cancelar" onAction="#cancelar"/>
    </HBox>
</VBox>
