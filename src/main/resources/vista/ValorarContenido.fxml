<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="200" prefWidth="300" spacing="10" style="-fx-padding: 15;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="controladores.ValorarContenidoController">
   <Pane prefHeight="71.0" prefWidth="302.0" style="-fx-background-color: #d6dcfd;">
      <children>
      
          <Label layoutX="71.0" layoutY="12.0" style="-fx-font-size: 16px;" text="Valorar Contenido">
            <font>
               <Font name="Baskerville Old Face" size="5.0" />
            </font>
            <textFill>
               <LinearGradient endX="1.0" startX="0.873817085843733" startY="0.5835962265447863">
                  <stops>
                     <Stop>
                        <color>
                           <Color />
                        </color>
                     </Stop>
                     <Stop offset="1.0">
                        <color>
                           <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                     </Stop>
                  </stops>
               </LinearGradient>
            </textFill>
         </Label>
      </children>
   </Pane>

    <Label text="Seleccione un puntaje (1 a 5):">
      <font>
         <Font name="System Bold Italic" size="12.0" />
      </font></Label>
    <ComboBox fx:id="comboPuntaje" style="-fx-background-color: #5e77ff;" />

    <HBox spacing="10">
        <Button onAction="#valorar" style="-fx-background-color: #5e77ff;" text="Valorar" textFill="WHITE" />
        <Button onAction="#cancelar" style="-fx-background-color: #5e77ff;" text="Cancelar" textFill="WHITE">
         <font>
            <Font name="Book Antiqua" size="12.0" />
         </font></Button>
    </HBox>
</VBox>
