<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600" prefWidth="800" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="controladores.PanelModeradorController">

    <left>
        <VBox prefWidth="200" spacing="15" style="-fx-padding: 20; -fx-background-color: #d6dcfd;">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="MODERADOR">
            <font>
               <Font name="Poor Richard" size="10.0" />
            </font></Label>
            <Button onAction="#mostrarUsuarios" prefHeight="25.0" prefWidth="107.0" style="-fx-background-color: #5e77ff;" text="Usuarios" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#mostrarContenidos" prefHeight="25.0" prefWidth="107.0" style="-fx-background-color: #5e77ff;" text="Contenidos" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#mostrarGrafo" prefHeight="25.0" prefWidth="107.0" style="-fx-background-color: #5e77ff;" text="Grafo Afinidad" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#mostrarReportes" prefHeight="25.0" prefWidth="107.0" style="-fx-background-color: #5e77ff;" text="Reportes" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#cerrarSesion" prefHeight="25.0" prefWidth="107.0" style="-fx-background-color: #c50600;" text="Cerrar Sesión" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="contentPane" style="-fx-background-color: white;" />
    </center>
</BorderPane>
