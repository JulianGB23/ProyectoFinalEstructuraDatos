<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500" prefWidth="700" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="controladores.SolicitudesController">

    <top>
        <Label style="-fx-font-size: 18px; -fx-padding: 10;" text="Solicitudes de Ayuda">
         <font>
            <Font name="Berlin Sans FB Bold" size="27.0" />
         </font></Label>
    </top>

    <center>
        <TableView fx:id="tablaSolicitudes">
            <columns>
                <TableColumn fx:id="colTema" prefWidth="200" style="-fx-background-color: #d6dcfd;" text="Tema" />
                <TableColumn fx:id="colUrgencia" prefWidth="150" style="-fx-background-color: #d6dcfd;" text="Urgencia" />
                <TableColumn fx:id="colEstado" prefWidth="150" style="-fx-background-color: #d6dcfd;" text="Estado" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 10;">
            <TextField fx:id="campoTema" promptText="Tema de la solicitud" />
            <ComboBox fx:id="comboUrgencia" promptText="Urgencia" style="-fx-background-color: #5e77ff;" />
            <Button onAction="#enviarSolicitud" style="-fx-background-color: #5e77ff;" text="Enviar Solicitud" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
        </HBox>
    </bottom>
</BorderPane>
