<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500" prefWidth="700" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="controladores.ChatController">

    <left>
        <VBox spacing="10" style="-fx-background-color: #d6dcfd;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Label text="Amigos">
            <font>
               <Font name="Poor Richard" size="24.0" />
            </font></Label>
            <ListView fx:id="listaAmigos" prefWidth="150" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10" style="-fx-background-color: white;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Label fx:id="labelChatCon" text="Selecciona un amigo para chatear">
            <font>
               <Font name="Poor Richard" size="16.0" />
            </font></Label>

            <ScrollPane fx:id="scrollMensajes" fitToWidth="true" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="contenedorMensajes" spacing="10">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>

            <HBox spacing="10">
                <TextField fx:id="campoMensaje" promptText="Escribe un mensaje..." HBox.hgrow="ALWAYS" />
                <Button onAction="#enviarMensaje" style="-fx-background-color: #5e77ff;" text="Enviar" textFill="WHITE">
               <font>
                  <Font name="Book Antiqua" size="12.0" />
               </font></Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
