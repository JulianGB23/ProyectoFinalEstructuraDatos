<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500" prefWidth="700" style="-fx-padding: 20;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/20.0.1" fx:controller="controladores.ContenidosModeradorController">

    <VBox spacing="15" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Contenidos" />

        <HBox spacing="10">
            <TextField fx:id="txtBuscar" promptText="Buscar por título o autor" HBox.hgrow="ALWAYS" />
            <Button onAction="#buscarContenido" style="-fx-background-color: #5e77ff;" text="Buscar" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
            <Button onAction="#mostrarTodos" style="-fx-background-color: #5e77ff;" text="Mostrar Todos" textFill="WHITE">
            <font>
               <Font name="Book Antiqua" size="12.0" />
            </font></Button>
        </HBox>

        <TableView fx:id="tablaContenidos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTitulo" prefWidth="150" style="-fx-background-color: #d6dcfd;" text="Título" />
                <TableColumn fx:id="colAutor" prefWidth="150" style="-fx-background-color: #d6dcfd;" text="Autor" />
                <TableColumn fx:id="colTipo" prefWidth="100" style="-fx-background-color: #d6dcfd;" text="Tipo" />
                <TableColumn fx:id="colValoraciones" prefWidth="100" style="-fx-background-color: #d6dcfd;" text="Valoraciones" />
                <TableColumn fx:id="colFecha" prefWidth="100" style="-fx-background-color: #d6dcfd;" text="Fecha" />
            </columns>
        </TableView>

        <Button onAction="#eliminarContenido" style="-fx-background-color: #5e77ff;" text="Eliminar Contenido Seleccionado" textFill="WHITE">
         <font>
            <Font name="Book Antiqua" size="12.0" />
         </font></Button>
    </VBox>
</AnchorPane>
